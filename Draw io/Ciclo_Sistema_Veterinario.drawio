        <mxCell id="legend_box" parent="1" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=10;spacingBottom=10;" value="CASOS DE USO&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;b&gt;CU-01: Registrar Tutor&lt;/b&gt;&lt;br&gt;Ingresa datos personales del propietario (Nombre, DPI, Teléfono, Dirección).&lt;br&gt;&lt;br&gt;&lt;b&gt;CU-02: Registrar Mascota—&lt;/b&gt;&lt;br&gt;Da de alta al paciente (Nombre, Especie, Raza, Peso, Edad) asignado a un tutor.&lt;br&gt;&lt;br&gt;&lt;b&gt;CU-03: Registrar Consulta&lt;/b&gt;&lt;br&gt;Registra visita, motivo, temperatura, diagnóstico y medicamentos recetados.&lt;br&gt;&lt;br&gt;&lt;b&gt;CU-04: Facturar Consulta&lt;/b&gt;&lt;br&gt;Calcula costos, genera e imprime comprobante de pago para el tutor.&lt;br&gt;&lt;br&gt;&lt;b&gt;CU-05: Consultar Expediente&lt;/b&gt;&lt;br&gt;Visualiza ficha técnica completa e historial médico cronológico del paciente.&lt;/div&gt;" vertex="1">
          <mxGeometry height="305" width="340" x="900" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ADi_XS6gRQ4EHN3aOpuS-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffeba6;strokeColor=#d6b656;align=left;verticalAlign=top;fontStyle=0;fontSize=11;fontColor=#333333;" value="REGLAS DE NEGOCIO Y CASOS DE USO:&#xa;1. CU-01: Registrar Tutor (Ingreso de datos personales).&#xa;2. CU-02: Registrar Mascota (Paciente vinculado a un tutor).&#xa;3. CU-03: Registrar Consulta (Historia clínica y diagnóstico).&#xa;4. CU-04: Facturar Consulta (Cálculos y emisión de factura).&#xa;5. CU-05: Consultar Expediente (Historial médico cronológico)." vertex="1">
